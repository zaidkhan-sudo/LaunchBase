# Server
PORT=8000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# JWT
JWT_SECRET=<random-256-bit-hex-string>

# Google OAuth (for email service)
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<your-google-client-secret>
GOOGLE_REFRESH_TOKEN=<your-google-refresh-token>
GOOGLE_USER=<your-email@gmail.com>

# AWS Credentials
AWS_ACCESS_KEY_ID=<your-aws-access-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=<your-aws-account-id>

# AWS VPC / Networking
AWS_VPC_ID=vpc-<id>
AWS_VPC_SUBNET_ID_1=subnet-<id>
AWS_VPC_SUBNET_ID_2=subnet-<id>
AWS_VPC_SECURITY_GROUP_ID=sg-<id>

# AWS ECS
AWS_ECS_EXECUTION_ROLE_ARN=arn:aws:iam::<account-id>:role/ecsTaskExecutionRole
AWS_ECS_CLUSTER_NAME=vercel-clone-cluster

# AWS ALB (optional — deployments work without these, but liveUrl will stay null)
AWS_ALB_DNS_NAME=<alb-dns-name>.elb.amazonaws.com
AWS_ALB_LISTENER_ARN=arn:aws:elasticloadbalancing:<region>:<account-id>:listener/app/<alb-name>/<id>/<id>
PLATFORM_DOMAIN=<your-domain.com>
